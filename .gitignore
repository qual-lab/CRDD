# Repository-local CRDD runtime state is untracked by default.
!/.crdd/
/.crdd/*
/.env
/.env-crdd

# Explicit non-secret repository configuration; each owner defines revision or working-file semantics.
!/.crdd/config/
/.crdd/config/*
!/.crdd/config/repository-manifest.json
!/.crdd/config/external-send-policy.json
!/.crdd/config/orchestrator.json
!/.crdd/config/execution-intelligence.json
!/.crdd/config/coordinator.json
!/.crdd/config/mcp-server.json
!/.crdd/config/workbench-server.json
!/.crdd/config/network-policy.json

# Network policy uses the current working file; execution binds its effective snapshot to consent.

# Configuration examples are distribution artifacts, not runtime state.
!/template/.crdd/
!/template/.crdd/config/
!/template/.crdd/config/*.example.json

# Tool package dependencies are restored from their lockfiles.
**/node_modules/

# Workbench Browser bundle is a deterministic generated Release artifact.
# The fixed production bundle is tracked so signed distributions can launch
# without restoring the build toolchain or importing React into the Node graph.
