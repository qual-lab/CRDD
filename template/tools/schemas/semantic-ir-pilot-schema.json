{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qual-lab.dev/crdd/schemas/semantic-ir-pilot-schema.json",
  "title": "CRDD Semantic IR Pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contractRevision",
    "stability",
    "subsystem",
    "sourceDocument",
    "sourceSha256",
    "meanings"
  ],
  "properties": {
    "contract": { "const": "crdd/semantic-ir-pilot" },
    "contractRevision": { "const": 0 },
    "stability": { "const": "pilot" },
    "subsystem": {
      "enum": ["coordinator", "project-runtime"]
    },
    "sourceDocument": {
      "type": "string",
      "pattern": "^06_Architecture/Details/(?:coordinator|project-runtime)/[^/]+\\.md$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "meanings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/meaning" }
    }
  },
  "$defs": {
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticKey",
        "kind",
        "statement",
        "archIds",
        "verification",
        "sourceSection",
        "notApplicableReason"
      ],
      "properties": {
        "semanticKey": {
          "type": "string",
          "pattern": "^(?:coordinator|project-runtime)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "statement": { "type": "string", "minLength": 1 },
        "archIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ARCH-[0-9]{6}$"
          }
        },
        "verification": {
          "enum": ["required", "not-applicable"]
        },
        "sourceSection": {
          "type": "string",
          "pattern": "^#{2,3} "
        },
        "notApplicableReason": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
