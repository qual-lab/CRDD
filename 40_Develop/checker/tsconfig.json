{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleDetection": "force",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "./crdd-check.ts",
    "./tests/integration/crdd-check.contract.test.ts",
    "./tests/integration/regression-runner.contract.test.ts",
    "./tests/integration/tools-naming.contract.test.ts",
    "./tests/unit/test-catalog.contract.test.ts",
    "./tests/unit/launcher-binding.contract.test.ts",
    "./tests/unit/symbol-graph.contract.test.ts",
    "./tests/unit/semantic-coverage-pilot.contract.test.ts",
    "./test-discovery.ts",
    "./test-runner.ts",
    "./test-catalog.ts",
    "./regression-runner.ts",
    "./fault-injector.ts",
    "./compile-semantic-ir-pilot.ts",
    "./src/launcher-binding.ts",
    "../../template/tools/crdd-check.ts"
  ]
}
