{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleDetection": "force",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "./bin/checker.ts",
    "./src/index.ts",
    "./src/profiles/current.ts",
    "./tests/integration/crdd-check.contract.test.ts",
    "./tests/integration/tools-naming.contract.test.ts",
    "./tests/integration/domain-outcome-adapter.contract.test.ts",
    "./tests/unit/inspection/pipeline.contract.test.ts",
    "./tests/unit/reality/symbol-graph.contract.test.ts",
    "./tests/support/test-discovery.ts",
    "./tests/support/fault-injector.ts",
    "./tests/test-runner.ts",
    "../../template/tools/crdd-check.ts"
  ]
}
