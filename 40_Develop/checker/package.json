{
  "name": "@qual-lab/crdd-checker",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "biome format --write ../..",
    "format:check": "biome format ../..",
    "lint": "biome lint ../.. --error-on-warnings",
    "test": "npm run check && npm run verify:repository && npm run test:run",
    "test:run": "node ./test-runner.ts",
    "test:catalog": "npm run check && npm run test:catalog:run",
    "test:catalog:run": "node --test ./tests/unit/test-catalog.contract.test.ts",
    "test:regression:plan": "node ./regression-runner.ts --base main --plan",
    "test:regression": "node ./regression-runner.ts --base main",
    "typecheck": "tsc -p ./tsconfig.json && tsc -p ./template-tools-tsconfig.json",
    "verify:repository": "node ./crdd-check.ts --root ../.. --json --summary"
  },
  "engines": {
    "node": ">=24.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
