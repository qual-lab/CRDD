{
  "name": "@qual-lab/crdd-checker",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "biome format --write ../..",
    "format:check": "biome format ../..",
    "lint": "biome lint ../.. --error-on-warnings",
    "test": "npm run check && npm run verify:repository && npm run test:run",
    "test:run": "node ./tests/test-runner.ts",
    "test:coverage": "node ./tests/test-runner.ts --coverage",
    "typecheck": "tsc -p ./tsconfig.json && tsc -p ./template-tools-tsconfig.json",
    "verify:repository": "node ./bin/checker.ts --root ../.. --json --summary",
    "semantic": "node ./bin/checker.ts --semantic",
    "catalog:check": "node ./bin/checker.ts --test-catalog",
    "test:plan": "node ./bin/checker.ts --test-catalog --base main"
  },
  "engines": {
    "node": ">=24.12"
  },
  "dependencies": {
    "@qual-lab/crdd-configuration-model": "file:../configuration-model",
    "@qual-lab/crdd-document-model": "file:../document-model",
    "@qual-lab/crdd-version-control": "file:../version-control"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
