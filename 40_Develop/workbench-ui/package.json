{
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "name": "@qual-lab/crdd-workbench-ui",
  "scripts": {
    "build": "vite build",
    "dev:client": "vite build --watch",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "tsc -p ./tsconfig.json",
    "test": "npm run check && npm run test:run",
    "test:run": "node --test ./tests/integration/*.test.ts",
    "test:credential-browser": "node --test ./tests/system/credential-administration-browser.contract.test.ts",
    "test:visual": "node --test --test-concurrency=1 ./tests/system/workbench-visual.integration.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-include=\"src/**/*.tsx\" --test ./tests/integration/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@qual-lab/crdd-ai-adapter": "file:../ai-adapter",
    "@qual-lab/crdd-configuration-model": "file:../configuration-model",
    "@qual-lab/crdd-document-model": "file:../document-model",
    "@qual-lab/crdd-server": "file:../crdd-server",
    "@qual-lab/crdd-version-control": "file:../version-control",
    "@qual-lab/crdd-visual-preview": "file:../visual-preview",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.0"
  }
}
