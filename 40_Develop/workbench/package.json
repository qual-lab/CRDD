{
  "name": "@qual-lab/crdd-workbench",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "start": "node ./bin/workbench.ts",
    "test": "npm run check && npm run test:run",
    "test:run": "node --test --test-concurrency=1 ./tests/integration/*.test.ts",
    "test:visual": "node --test --test-concurrency=1 ./tests/system/workbench-visual.system.test.ts",
    "typecheck": "tsc -p ./tsconfig.json"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
