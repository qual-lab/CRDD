{
  "name": "@qual-lab/crdd-ai-adapter",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "test": "npm run check && npm run test:run",
    "test:run": "node --test --test-concurrency=1 ./tests/**/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test --test-concurrency=1 \"./tests/unit/**/*.test.ts\"",
    "claude-structured-result:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test ./tests/unit/claude/result.contract.test.ts",
    "typecheck": "tsc -p ./tsconfig.json"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
