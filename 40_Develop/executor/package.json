{
  "name": "@qual-lab/crdd-executor",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "biome lint . --error-on-warnings",
    "test": "npm run check && npm run test:run",
    "result:coverage": "node --experimental-test-coverage --test ./tests/unit/attempt/*.test.ts ./tests/unit/controller.contract.test.ts",
    "report:coverage": "node --experimental-test-coverage --test-coverage-include=tests/support/report.ts --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=80 --test ./tests/integration/report.integration.test.ts ./tests/unit/report.contract.test.ts",
    "test:run": "node --experimental-test-module-mocks --test --test-concurrency=1 ./tests/**/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --experimental-test-module-mocks --test --test-concurrency=1 ./tests/**/*.test.ts",
    "verify:standalone": "node ./tests/system/manual/verify-provider-attempt.ts",
    "verify:home-boundary": "node ./tests/system/manual/verify-provider-home.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
