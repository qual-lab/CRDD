{
  "name": "@qual-lab/crdd-server",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "exports": {
    "./mcp": "./src/transport/mcp-server.ts",
    "./api": "./src/app.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format:check": "biome format . ../../template/tools/crdd-server.ts",
    "lint": "biome lint . ../../template/tools/crdd-server.ts --error-on-warnings",
    "test": "npm run check && npm run test:run",
    "test:run": "node --experimental-test-module-mocks --test --test-concurrency=1 \"--test-skip-pattern=^Host Windows:\" ./tests/unit/**/*.test.ts ./tests/integration/*.test.ts ./tests/integration/diagnostic/*.test.ts ./tests/system/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --experimental-test-module-mocks --test --test-concurrency=1 \"--test-skip-pattern=^Host Windows:\" ./tests/unit/**/*.test.ts ./tests/integration/*.test.ts",
    "typecheck": "tsc -p ./tsconfig.json && tsc -p ./tsconfig-launcher.json",
    "build:ui": "npm --prefix ../workbench-ui run build",
    "prestart": "npm run build:ui",
    "pretest": "npm run build:ui",
    "start": "node ./bin/crdd-server.ts",
    "test:host-windows": "node --experimental-test-module-mocks --test --test-concurrency=1 \"--test-name-pattern=^Host Windows:\" ./tests/integration/recovery-http-owner.integration.test.ts",
    "test:entry": "node --test ./tests/system/workbench-server-entry.integration.test.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/express": "5.0.6",
    "@types/node": "22.18.0",
    "swagger-ui-dist": "5.35.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0"
  }
}
