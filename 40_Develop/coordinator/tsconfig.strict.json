    "scripts/verify-reviewer-boundary.ts",
    "src/cli/options.ts",
    "src/execution/recovery.ts",
    "scripts/runtime-traceability.ts",
    "src/execution/authority.ts",
    "../ai-adapter/src/claude/plan.ts",
    "src/execution/operation.ts",
    "../domain-model/src/plain-data/snapshot.ts",
    "../platform-access/src/index.ts",
