    "scripts/revoke-external-send-consent.ts",
    "src/execution/advice.ts",
    "src/execution/diagnostics.ts",
    "bin/coordinator.ts",
    "scripts/verify-native-protection.ts",
    "scripts/verify-native-terminal-fixtures.ts",
    "scripts/check-dynamic-fake-provider-coverage.ts",
    "scripts/check-provider-authority-coverage.ts",
    "scripts/check-provider-home-coverage.ts",
    "scripts/check-platform-access-coverage.ts",
    "scripts/check-platform-access-ts-coverage.ts",
    "scripts/check-native-runtime-trace.ts",
    "scripts/check-runtime-traceability.ts",
    "scripts/check-task-design-traceability.ts",
    "scripts/platform-access-coverage-path.ts",
    "scripts/prepare-codex-image.ts",
    "scripts/verify-dynamic-fake-provider-cancellation.ts",
    "scripts/verify-dynamic-fake-provider-failures.ts",
