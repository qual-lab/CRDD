+//! 試験専用の終了観測。取消・kill・abortを発行しない。
+//! @packageDocumentation
+//! @responsibility 実搬送と所有Task／Hostの終了を試験scopeへ相関して記録する。
+//! @trace ERB-IT-025 ERB-IT-026 ERB-IT-027 ERB-IT-028 ERB-IT-029
+//! @level IT
+//! @scope 固定HostとCoreの搬送、Task寿命、Host生成世代とreap。
+//! @boundary 観測専用であり、Provider要求や故障注入のAuthorityを持たない。
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex, OnceLock};
+
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+/// 終了確認に必要なTask責務を識別する。
+/// @responsibility 配送、実処理、監視とSession終了を別の登録へ分ける。
+/// @trace ERB-IT-025 ERB-IT-027 ERB-IT-029
+/// @shape Core、IPC、delegateとSessionが所有するRole分類。
+/// @invariant 一Roleの終了を別Roleの終了へ読み替えない。
+/// @boundary 試験観測器と各実Task。
+/// @security Role名は操作権を付与しない。
+/// @compatibility 必須Role集合はシナリオごとに明示して照合する。
+pub enum Role {
+    Reader,
+    Writer,
+    Driver,
+    Supervisor,
+    Stderr,
+    DelegateBody,
+    DelegateDelivery,
+    CoreWorker,
+    CoreDispatch,
+    Watcher,
+    SessionOpen,
+    SessionShutdown,
+}
+
+/// 禁止delegate一要求の実搬送段階。Queue受理はHost結果ではない。
+/// @responsibility 同じCellとRuntime呼出IDの観測を順序付きに区別する。
+/// @trace ERB-IT-027
+/// @shape IPC受理からDriver配送Queue受理までの六段階。
+/// @invariant Queue受理をHost結果観測へ読み替えない。
+/// @boundary 禁止delegateの実搬送点。
+/// @security Handler許可を段階記録から導かない。
+/// @compatibility 順序Oracleと全搬送点を共同で変更する。
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DelegateStage {
+    IpcReceived,
+    BodyStarted,
+    CoreSubmitted,
+    RegistryRejected,
+    BodyCompleted,
+    DriverQueueAccepted,
+}
+
+/// namespace正規化後の要求Identity。値は試験用固定入力に限定する。
+/// @responsibility 別Cell、別呼出または別namespaceを同じ拒否へ畳まない。
+/// @trace ERB-IT-027
+/// @shape Cell、Runtime呼出ID、namespaceとTool名の四値。
+/// @invariant namespace正規化以外で異なる要求を統合しない。
+/// @boundary 同一試験scopeの要求相関。
+/// @security 値は試験用固定入力に限定する。
+/// @compatibility N/A: 非永続の内部キーである。
+type DelegateKey = (String, String, String, String);
+
+/// 観測scopeの登録資源と搬送履歴を保持する。
+/// @responsibility 未観測、失敗観測と正常終了を区別する。
+/// @trace ERB-IT-025 ERB-IT-027 ERB-IT-029
+/// @shape 単調ID、Task終了表、Host世代別reap表と要求段階列。
+/// @invariant Mutex内で更新し、重複段階を削除しない。
+/// @boundary 観測Owner内のメモリ状態。
+/// @security 資源操作やProvider出力を保持しない。
+/// @compatibility N/A: 外部交換しない試験状態である。
+#[derive(Default)]
+struct State {
+    next: u64,
+    tasks: BTreeMap<u64, (Role, bool)>,
+    hosts: BTreeMap<(u32, u64), Option<bool>>,
+    delegates: BTreeMap<DelegateKey, Vec<DelegateStage>>,
+}
+
+/// 現在のscopeへ要求段階を観測する。同期GateやEffectを追加しない。
+/// @responsibility 実搬送点の観測だけを試験所有scopeへ接続する。
+/// @trace ERB-IT-027
+/// @precondition 入力は実要求のCell、Runtime IDとTool Identityである。
+/// @stimulus 搬送点から現在の段階を渡す。
+/// @observation 同じIdentityの順序付き段階記録。
+/// @oracle scopeがなければ他のscopeへ記録しない。
+/// @cleanup N/A: 新しいTask、Processまたは待機を作らない。
+/// @boundary 試験専用の観測記録。本番Policyと搬送を変更しない。
+pub fn observe_delegate(
+    stage: DelegateStage,
+    cell_id: &str,
+    runtime_id: &str,
+    namespace: Option<&str>,
+    name: &str,
+) {
+    if let Some(observation) = current_observation() {
+        observation.delegate_stage(stage, cell_id, runtime_id, namespace, name);
+    }
+}
+
+/// 観測記録の所有主体を共有する。
+/// @responsibility 遅延終了を開始時scopeへ戻す。
+/// @trace ERB-IT-025 ERB-IT-027 ERB-IT-029
+/// @shape Mutexで共有するStateへのArc。
+/// @invariant clone後も同じOwnerの記録を参照する。
+/// @boundary TaskとHostの観測scope。
+/// @security 終了要求を発行する機能を持たない。
+/// @compatibility N/A: 試験build内の共有値である。
+#[derive(Clone, Default)]
+pub struct Observation(Arc<Mutex<State>>);
+
+/// 登録Taskの終了記録を所有する。
+/// @responsibility 同じTaskを二回終了済みにしない。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @shape 開始時Observationと登録ID。
+/// @invariant Dropは登録時のOwnerだけを更新する。
+/// @boundary 所有Futureと終了観測。
+/// @security Dropをcancelやkillの操作として使わない。
+/// @compatibility N/A: Task寿命に限定したRAII値である。
+pub struct TaskGuard {
+    observation: Observation,
+    id: u64,
+}
+
+/// poll前からFutureの寿命を登録する。
+/// @responsibility 未poll破棄と子Taskの終了を開始時Ownerへ結ぶ。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @precondition 対象FutureとRoleを生成側が所有する。
+/// @stimulus Futureを一回包み、開始時の観測scopeを捕捉する。
+/// @observation 登録Taskと内側Futureの破棄順序。
+/// @oracle 未pollでも登録し、内側破棄後に終了記録を更新する。
+/// @cleanup wrapper破棄時にFutureとGuardを順序付きで解放する。
+/// @boundary Futureの実行結果や取消処理は変更しない。
+pub fn observe_future<F: std::future::Future>(
+    role: Role,
+    future: F,
+) -> impl std::future::Future<Output = F::Output> {
+    let observation = current_observation();
+    let guard = observation.as_ref().map(|value| value.task(role));
+    #[cfg(feature = "crdd-lifecycle-observation")]
+    let future = TASK_OBSERVATION.scope(observation, future);
+    ObservedFuture {
+        future: Some(Box::pin(future)),
+        guard,
+    }
+}
+
+/// 内側Futureを先に破棄する観測wrapper。
+/// @responsibility Guardの終了記録を内側資源解放より先に出さない。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @shape 所有するPin<Box<Future>>と任意Guard。
+/// @invariant Futureは一度だけ破棄し、その後Guardを解放する。
+/// @boundary 内側Futureの寿命とTask観測。
+/// @security 内側へ新しい操作権を付与しない。
+/// @compatibility FutureのOutputとpoll結果をそのまま返す。
+struct ObservedFuture<F> {
+    future: Option<std::pin::Pin<Box<F>>>,
+    guard: Option<TaskGuard>,
+}
+
+impl<F: std::future::Future> std::future::Future for ObservedFuture<F> {
+    type Output = F::Output;
+    /// 内側Futureのpollをそのまま搬送する。
+    /// @responsibility 観測器が処理結果を生成しない。
+    /// @trace ERB-IT-025
+    /// @precondition wrapperが内側Futureを所有している。
+    /// @stimulus Executorからのpoll。
+    /// @observation 内側のPoll結果。
+    /// @oracle OutputとPendingを変換しない。
+    /// @cleanup N/A: pollでは所有Futureを解放しない。
+    /// @boundary 同一FutureのExecutor接続。
+    fn poll(
+        self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Self::Output> {
+        self.get_mut()
+            .future
+            .as_mut()
+            .expect("owned future")
+            .as_mut()
+            .poll(cx)
+    }
+}
+
+impl<F> Drop for ObservedFuture<F> {
+    /// 内側の終了後に観測Guardを解放する。
+    /// @responsibility 内側Dropが未完了の間は終了済みと記録しない。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition wrapperが破棄される。
+    /// @stimulus 正常・未poll・取消後のDrop。
+    /// @observation 内側破棄とGuard破棄の順序。
+    /// @oracle Guard終了は内側Dropのreturnより後になる。
+    /// @cleanup FutureとGuardをそれぞれ一回解放する。
+    /// @boundary DropからcancelやHost終了を発行しない。
+    fn drop(&mut self) {
+        drop(self.future.take());
+        drop(self.guard.take());
+    }
+}
+
+#[cfg(feature = "crdd-lifecycle-observation")]
+tokio::task_local! { static TASK_OBSERVATION: Option<Observation>; }
+
+/// Task局所の開始時Ownerを優先して読み取る。
+/// @responsibility global切替後の子Taskを別scopeへ混入させない。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @precondition 明示scopeまたはscope付きTaskから呼ぶ。
+/// @stimulus 現在の観測Owner取得。
+/// @observation Task局所Owner、なければglobal登録。
+/// @oracle Task局所のNoneもglobal値で補完しない。
+/// @cleanup 呼出側が取得したArcを使用後に解放する。
+/// @boundary Owner取得だけでTask／Hostを生成しない。
+fn current_observation() -> Option<Observation> {
+    #[cfg(feature = "crdd-lifecycle-observation")]
+    if let Ok(observation) = TASK_OBSERVATION.try_with(Clone::clone) {
+        return observation;
+    }
+    ACTIVE
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .expect("scope lock poisoned")
+        .clone()
+}
+
+static ACTIVE: OnceLock<Mutex<Option<Observation>>> = OnceLock::new();
+
+/// 一つのglobal観測scopeを所有する。
+/// @responsibility 自身の登録だけをDropで解除する。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @shape 登録したObservation。
+/// @invariant 同時に二つの登録を成立させない。
+/// @boundary 試験の観測scope登録。
+/// @security 登録解除を資源回収完了へ読み替えない。
+/// @compatibility N/A: 試験内のRAII値である。
+pub struct Installation(Observation);
+
+/// 観測Ownerを明示登録する。
+/// @responsibility feature有効化だけで登録を開始しない。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @precondition 他のglobal観測scopeがない。
+/// @stimulus 試験のObservationを登録する。
+/// @observation 登録OwnerのIdentity。
+/// @oracle 同時登録を拒否する。
+/// @cleanup InstallationのDropで登録解除する。
+/// @boundary Policyや資源終了の操作を変更しない。
+pub fn install(observation: Observation) -> Installation {
+    let mut active = ACTIVE
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .expect("scope lock poisoned");
+    assert!(active.is_none(), "concurrent observation scope forbidden");
+    *active = Some(observation.clone());
+    Installation(observation)
+}
+
+/// 現在scopeへTask寿命を登録する。
+/// @responsibility scope不在を他試験の記録で埋めない。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @precondition 呼出側がRoleに対応する処理寿命を所有する。
+/// @stimulus 実Taskの開始点。
+/// @observation 開始時Ownerと登録Guard。
+/// @oracle scope不在ではNoneを返す。
+/// @cleanup 呼出側がTask終端でGuardを解放する。
+/// @boundary Guard生成はTask自体をspawnしない。
+pub fn observe_task(role: Role) -> Option<TaskGuard> {
+    current_observation()
+        .as_ref()
+        .map(|observation| observation.task(role))
+}
+
+impl Drop for Installation {
+    /// 自身の観測登録だけを解除する。
+    /// @responsibility 別Ownerの登録を消さない。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 自身がglobal登録を所有する。
+    /// @stimulus 試験scopeのDrop。
+    /// @observation 登録ArcのIdentity。
+    /// @oracle 不一致はassertで拒否する。
+    /// @cleanup global登録をNoneへ戻す。
+    /// @boundary 進行中Taskの開始時Ownerは保持する。
+    fn drop(&mut self) {
+        let mut active = ACTIVE
+            .get_or_init(|| Mutex::new(None))
+            .lock()
+            .expect("scope lock poisoned");
+        assert!(
+            active
+                .as_ref()
+                .is_some_and(|value| Arc::ptr_eq(&value.0, &self.0.0))
+        );
+        *active = None;
+    }
+}
