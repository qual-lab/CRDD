+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 別Connectionの同番号Requestを解除しないことを反証する。
+    /// @responsibility ConnectionごとのRequest ID再利用を区別する。
+    /// @trace ERB-IT-029
+    /// @precondition 同一Ownerに二つの実Connection対応を構築する単体試験。
+    /// @stimulus 両方のRequest 1を登録し、片側ずつ解除する。
+    /// @observation 各exact Targetの選択とmatches結果。
+    /// @oracle Aの解除でBが現在表から消えない。
+    /// @cleanup Ownerと二Channelを解放する。
+    /// @boundary 実Host故障の根拠にはしない。
+    #[test]
+    fn request_removal_is_connection_scoped() {
+        let owner = FaultOwner::default();
+        let (first, _first_receiver) =
+            bind_host(Some(owner.clone()), 301, 1).expect("first connection");
+        let (second, _second_receiver) =
+            bind_host(Some(owner.clone()), 302, 2).expect("second connection");
+        first.bind_cell("first-cell");
+        second.bind_cell("second-cell");
+        first.wait_started("first-cell", RequestId::new(1), CancellationToken::new());
+        second.wait_started("second-cell", RequestId::new(1), CancellationToken::new());
+        let second_target = owner.target("second-cell").expect("second pending");
+        first.wait_finished(RequestId::new(1));
+        assert!(owner.target("first-cell").is_none());
+        assert_eq!(owner.target("second-cell"), Some(second_target.clone()));
+        assert!(second.matches(&second_target));
+        second.wait_finished(RequestId::new(1));
+        assert!(owner.target("second-cell").is_none());
+        assert!(!second.matches(&second_target));
+    }
+
+    /// 現在のexact待機、取消、解除と発行履歴を反証する。
+    /// @responsibility 同じCellの複数Waitと閉鎖後の履歴を区別する。
+    /// @trace ERB-IT-029
+    /// @precondition 実Hostを起動しないOwner単体試験である。
+    /// @stimulus 未開始、別ID、二Wait、片側解除、取消、Cell／Connection閉鎖を構築する。
+    /// @observation 対象選択、注入受付と発行履歴の一致。
+    /// @oracle 別Cell／Request／世代／kindの結果流用を拒否する。
+    /// @cleanup ChannelとOwnerを試験終了で解放する。
+    /// @boundary 実故障やHost回収の根拠にはしない。
+    #[tokio::test]
+    async fn exact_pending_and_history() {
+        let owner = FaultOwner::default();
+        let (binding, mut receiver) =
+            bind_host(Some(owner.clone()), 101, 1).expect("explicit owner");
+        binding.bind_cell("cell-a");
+        binding.bind_cell("cell-b");
+        assert!(owner.target("cell-a").is_none());
+        let token = CancellationToken::new();
+        binding.wait_started("cell-a", RequestId::new(1), token.clone());
+        let first = owner.target("cell-a").expect("one pending");
+        let mut wrong = first.clone();
+        wrong.request_id = RequestId::new(9);
+        assert!(!binding.matches(&wrong));
+        assert!(owner.inject(wrong, FaultKind::HostLoss).await.is_err());
+        binding.wait_started("cell-a", RequestId::new(2), CancellationToken::new());
+        assert!(
+            owner.target("cell-a").is_none(),
+            "two pending requests are ambiguous"
+        );
+        binding.wait_finished(RequestId::new(2));
+        assert_eq!(owner.target("cell-a"), Some(first.clone()));
+        token.cancel();
+        assert!(!binding.matches(&first));
+        assert!(
+            owner
+                .inject(first.clone(), FaultKind::HostLoss)
+                .await
+                .is_err()
+        );
+        binding.wait_finished(RequestId::new(1));
+        assert!(owner.target("cell-a").is_none());
+        binding.wait_started("cell-a", RequestId::new(3), CancellationToken::new());
+        let target = owner.target("cell-a").expect("fresh request");
+        let request_owner = owner.clone();
+        let request_target = target.clone();
+        let task = tokio::spawn(async move {
+            request_owner
+                .inject(request_target, FaultKind::HostLoss)
+                .await
+        });
+        let request = tokio::time::timeout(std::time::Duration::from_secs(2), receiver.recv())
+            .await
+            .expect("bounded receive")
+            .expect("request");
+        assert!(binding.matches(&request.target));
+        binding.issued(request.kind, request.target.clone());
+        request
+            .response
+            .send(Ok(()))
+            .expect("owned result receiver");
+        task.await
+            .expect("joined injector")
+            .expect("accepted request");
+        assert!(
+            owner
+                .inject(target.clone(), FaultKind::HostLoss)
+                .await
+                .is_err(),
+            "duplicate injection"
+        );
+        binding.branch("child");
+        binding.connection_closed();
+        assert!(owner.target("cell-a").is_none());
+        assert!(!binding.matches(&target));
+        assert_eq!(
+            owner.branch_after_injection(&target, FaultKind::HostLoss),
+            Some("child")
+        );
+        assert!(
+            owner
+                .branch_after_injection(&target, FaultKind::ReaderLoss)
+                .is_none()
+        );
+        for field in 0..3 {
