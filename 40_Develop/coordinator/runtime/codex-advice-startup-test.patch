+/// 試験Sessionの終了処理を本番のshutdownへ接続する。
+///
+/// @responsibility 成功・失敗後に同じSessionのRuntimeを終了する。
+/// @trace ERB-IT-024
+/// @input 試験が所有するSession。
+/// @returns shutdownの完了結果。
+/// @precondition 固定SourceとProduction起動Patchを適用済みである。
+/// @postcondition 試験結果をProductionの完成結果へ読み替えない。
+/// @effect Session所有資源の終了を要求して待機する。
+/// @failure shutdownが完了できなければ試験を合格にしない。
+/// @invariant Provider Turnを送信せず、禁止System Toolを実行しない。
+/// @boundary 実Session起動、Tool登録およびRegistry配送の試験境界。
+/// @security 試験用認証だけを使用し、秘密値や生Provider出力を記録しない。
+/// @concurrency N/A: 試験内で順序付きに実行する。
+pub(crate) async fn shutdown_crdd_advice_session(session: &Arc<Session>) -> bool {
+    handlers::shutdown(session, "crdd-advice-test-shutdown".to_string()).await
+}
