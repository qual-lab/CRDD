+    fn late_reap_is_bound_to_original_scope_not_reused_pid() {
+        let first = Observation::default();
+        let installation = install(first.clone());
+        let old_host = host_started(33).expect("first scope");
+        drop(first.task(Role::Supervisor));
+        drop(installation);
+
+        let second = Observation::default();
+        let installation = install(second.clone());
+        let new_host = host_started(33).expect("second scope");
+        drop(second.task(Role::Supervisor));
+        old_host.reaped(true);
+        assert!(first.is_closed(&[Role::Supervisor]));
+        assert!(!second.is_closed(&[Role::Supervisor]));
+        new_host.reaped(true);
+        assert!(second.is_closed(&[Role::Supervisor]));
+        drop(installation);
+    }
+
+    /// 開始予約をpoll前に登録する。
+    /// @responsibility 予約中の終了を成功へ畳まない。
+    /// @trace ERB-IT-025
+    /// @precondition 明示scopeと固定Host記録を用意する。
