+    /// @responsibility global切替後の子Task観測を旧Ownerへ結ぶ。
+    /// @trace ERB-IT-025
+    /// @precondition 単一Thread Runtimeと明示scopeを用意する。
+    /// @stimulus Aで保留Taskをspawnし、Bへの切替後に解放する。
+    /// @observation CoreWorkerとCoreDispatchのOwner。
+    /// @oracle Aだけが両Roleでclosedになり、BへDispatchを混入しない。
+    /// @cleanup Taskをjoinし、InstallationとRuntimeを破棄する。
+    /// @boundary 実HostではなくTask局所Owner継承の試験である。
+    #[cfg(feature = "crdd-lifecycle-observation")]
+    #[test]
+    fn child_task_inherits_original_scope_after_global_scope_changes() {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .expect("runtime");
+        runtime.block_on(async {
+            let first = Observation::default();
+            let installation = install(first.clone());
+            host_started(66).expect("first host").reaped(true);
+            let (release_tx, release_rx) = tokio::sync::oneshot::channel::<()>();
+            let worker = tokio::spawn(observe_future(Role::CoreWorker, async move {
+                release_rx.await.expect("release old task");
+                drop(observe_task(Role::CoreDispatch));
+            }));
+            drop(installation);
+            let second = Observation::default();
+            let installation = install(second.clone());
+            host_started(66).expect("second host").reaped(true);
+            drop(second.task(Role::Reader));
+            release_tx.send(()).expect("release old task");
+            worker.await.expect("old worker joined");
+            assert!(first.is_closed(&[Role::CoreWorker, Role::CoreDispatch]));
+            assert!(!second.is_closed(&[Role::CoreDispatch]));
+            drop(installation);
+        });
+    }
