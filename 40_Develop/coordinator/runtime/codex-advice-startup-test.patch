+//! 明示的な試験scopeだけで有効になる、exact Connectionの故障注入Owner。
+//! @packageDocumentation
+//! @responsibility 実HostとReaderへの試験専用故障要求をexact対象へ結合する。
+//! @trace ERB-IT-029
+//! @level IT
+//! @scope 同一Host世代、Cell、待機Requestの故障注入と現在対応の解除。
+//! @boundary Provider要求と公開CLI取消には接続しない。通常buildではfeature無効。
+use codex_code_mode_protocol::host::RequestId;
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex, OnceLock};
+use tokio::sync::{mpsc, oneshot};
+use tokio_util::sync::CancellationToken;
+
+/// 同じConnectionに対して選択する一回限りの故障。
+/// @responsibility Host喪失とクライアント側Reader喪失を混同しない。
+/// @trace ERB-IT-029
+/// @shape Host全体の喪失とクライアントReader Task喪失の二分類。
+/// @invariant 一要求で一つの故障だけを選ぶ。
+/// @boundary 明示試験scopeのConnection Supervisor。
+/// @security 通常の取消やProvider操作の権限を表さない。
+/// @compatibility 新分類はSupervisor処置と独立試験を揃えて追加する。
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FaultKind {
+    HostLoss,
+    ReaderLoss,
+}
+
+/// 実ExecutionStartedから得たCellと実Host世代の結合。
+/// @responsibility 名前やscope内の件数を対象Identityの代替にしない。
+/// @trace ERB-IT-029
+/// @shape 公開Cell ID、実Host PID、生成世代とConnection内Request ID。
+/// @invariant 四値が現在の同一待機要求へ一致することを操作前に照合する。
+/// @boundary 試験Ownerと実Connectionの結合。
+/// @security IDの所持だけでは故障要求を許可しない。
+/// @compatibility Request IDはConnectionを越えて一意とはみなさない。
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct FaultTarget {
+    pub cell_id: String,
+    pub pid: u32,
+    pub generation: u64,
+    pub request_id: RequestId,
+}
+
+/// 一Host世代の故障要求と実終端観測を保持する。
+/// @responsibility 要求、操作発行と実Supervisor分岐を分離する。
+/// @trace ERB-IT-029
+/// @shape 専用Channel、要求Target、発行Targetと最初の終端分岐。
+/// @invariant 要求と発行は各一回に限定し、履歴を現在pendingへ読み替えない。
+/// @boundary 故障Ownerの内部記録。
+/// @security Channelは明示Ownerへ結合したConnectionだけが受信する。
+/// @compatibility N/A: 単一試験build内の非永続記録である。
+struct HostRecord {
+    sender: mpsc::UnboundedSender<FaultRequest>,
+    requested: Option<(FaultKind, FaultTarget)>,
+    issued: Option<(FaultKind, FaultTarget)>,
+    supervisor_branch: Option<&'static str>,
+}
+
+/// Host、Cellと現在待機の相関表をまとめる。
+/// @responsibility 発行履歴と取消可能な現在対応を別に保持する。
+/// @trace ERB-IT-029
+/// @shape Host世代表、Cell対応表とRequest／取消Tokenの待機表。
+/// @invariant 同じOwnerのMutexを保持した処理だけが表を更新する。
+/// @boundary 故障注入scope内のメモリ状態。
+/// @security 別Connectionの同番号Requestを解除対象へ含めない。
+/// @compatibility N/A: 永続化や外部交換をしない。
+#[derive(Default)]
+struct State {
+    hosts: BTreeMap<(u32, u64), HostRecord>,
+    cells: BTreeMap<String, (u32, u64)>,
+    pending_waits: BTreeMap<String, Vec<(RequestId, CancellationToken)>>,
+}
+
+impl State {
+    /// 現在のexact待機と未取消を読み取る。
+    /// @responsibility 履歴を現在pendingへ読み替えない。
+    /// @trace ERB-IT-029
+    /// @precondition OwnerのState lockを呼出し元が保持している。
+    /// @stimulus 照合するHost世代、CellとRequest。
+    /// @observation 現在対応と待機Tokenの取消状態。
+    /// @oracle 全対応が一致し、同じRequestが未取消の場合だけtrue。
+    /// @cleanup N/A: 保持済みStateの読取りだけである。
+    /// @boundary Host受信や資源回収の成立を主張しない。
+    fn current(&self, target: &FaultTarget) -> bool {
+        self.cells.get(&target.cell_id) == Some(&(target.pid, target.generation))
+            && self
+                .pending_waits
+                .get(&target.cell_id)
+                .is_some_and(|waits| {
+                    waits
+                        .iter()
+                        .any(|(id, token)| *id == target.request_id && !token.is_cancelled())
+                })
+    }
+}
+
+/// 故障注入の相関状態を試験が所有する。
+/// @responsibility 明示登録された試験だけに故障要求の搬送を許す。
+/// @trace ERB-IT-029
+/// @shape Mutexで共有するStateへのArc。
+/// @invariant cloneは同じOwnerを共有し、別Ownerへの記録移送をしない。
+/// @boundary 試験scopeとConnectionの専用注入Channel。
+/// @security featureの有効化だけでは登録・操作を開始しない。
+/// @compatibility N/A: Runtime公開APIや耐久Authorityではない。
+#[derive(Clone, Default)]
+pub struct FaultOwner(Arc<Mutex<State>>);
+
+/// 登録した故障Ownerの寿命を保持する。
+/// @responsibility Dropで自身のglobal登録だけを解除する。
+/// @trace ERB-IT-029
+/// @shape 登録時と同じFaultOwner。
+/// @invariant 同時に二つのInstallationを成立させない。
+/// @boundary 試験Ownerの登録scope。
+/// @security 登録解除をHost終了の証明にしない。
+/// @compatibility N/A: 試験内RAII値である。
+pub struct Installation(FaultOwner);
+
+static ACTIVE: OnceLock<Mutex<Option<FaultOwner>>> = OnceLock::new();
+
+/// Host開始時に明示scopeを捕捉する。
+/// @responsibility handshake待機中のOwner切替を取り込まない。
+/// @trace ERB-IT-029
+/// @precondition Host開始前に試験scopeの登録有無を確定する。
+/// @stimulus N/A: 開始時の登録Ownerを読み取る。
+/// @observation 捕捉したOwnerまたは登録不在。
+/// @oracle handshake中の後続登録を開始時Ownerへ混入しない。
+/// @cleanup 呼出し元が捕捉OwnerをConnection終了時に解放する。
+/// @boundary 故障要求を発行せず、試験scopeのIdentityだけを保持する。
+pub(crate) fn capture_owner() -> Option<FaultOwner> {
+    ACTIVE
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .expect("fault scope lock")
+        .clone()
+}
+
+/// Supervisorへ送るexact故障要求を表す。
+/// @responsibility 対象照合と操作受理の応答を同じ要求へ結ぶ。
+/// @trace ERB-IT-029
+/// @shape Target、故障分類と一回限りの応答Channel。
+/// @invariant 応答受理は実終了や回収成立を意味しない。
+/// @boundary OwnerからConnection Supervisorへの試験専用搬送。
+/// @security 通常のDriverEventや取消Tokenを改変する要求ではない。
+/// @compatibility N/A: 外部へ公開しない試験用メッセージである。
+pub(crate) struct FaultRequest {
+    pub(crate) target: FaultTarget,
+    pub(crate) kind: FaultKind,
+    pub(crate) response: oneshot::Sender<Result<(), String>>,
+}
+
+/// 一実Host世代へ固定した故障結合を保持する。
+/// @responsibility 別Host世代へ故障要求を流用しない。
+/// @trace ERB-IT-029
+/// @shape 開始時Owner、実PIDと生成世代。
+/// @invariant Connection開始後のglobal Owner切替を取り込まない。
+/// @boundary Connectionと故障Owner。
+/// @security 操作前にCellとRequestの現在対応も確認する。
+/// @compatibility N/A: 当該Connectionの寿命に限定する。
+#[derive(Clone)]
+pub(crate) struct ConnectionFault {
+    owner: FaultOwner,
+    pid: u32,
+    generation: u64,
+}
+
+/// 明示的な試験Ownerを一scopeだけ登録する。
+/// @responsibility feature有効化だけで故障注入を登録しない。
+/// @trace ERB-IT-029
+/// @precondition 他の故障scopeがない。
+/// @stimulus 試験が専用Ownerを渡す。
+/// @observation 現在の登録Owner。
+/// @oracle 二つの同時scopeを拒否する。
+/// @cleanup InstallationのDropで登録を解除する。
+/// @boundary 本番Policyと通常取消に接続しない。
+pub fn install(owner: FaultOwner) -> Installation {
+    let mut active = ACTIVE
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .expect("fault scope lock");
+    assert!(active.is_none(), "concurrent fault scope forbidden");
+    *active = Some(owner.clone());
+    Installation(owner)
+}
+
+impl Drop for Installation {
+    /// このInstallationが所有する登録だけを解除する。
+    /// @responsibility 別Ownerへの登録解除を拒否する。
+    /// @trace ERB-IT-029
+    /// @precondition 同時scopeを禁止したInstallationを破棄する。
+    /// @stimulus RAIIの終了。
+    /// @observation 登録OwnerのArc Identity。
+    /// @oracle 自身と一致する登録だけをNoneへ戻す。
+    /// @cleanup global登録を解除し、保持Ownerを解放する。
+    /// @boundary Host終了やChannel終了を登録解除から推定しない。
+    fn drop(&mut self) {
+        let mut active = ACTIVE
+            .get_or_init(|| Mutex::new(None))
+            .lock()
+            .expect("fault scope lock");
+        assert!(
+            active
+                .as_ref()
+                .is_some_and(|owner| Arc::ptr_eq(&owner.0, &self.0.0))
+        );
+        *active = None;
+    }
+}
+
+/// 実HostとConnectionへ一つの注入Channelを結合する。
+/// @responsibility 実Childの世代以外へ操作を搬送しない。
+/// @trace ERB-IT-029
+/// @precondition 実Child生成と観測世代が確定している。
+/// @stimulus 所有ConnectionからPIDと世代を渡す。
+/// @observation Channelと実Host Identity。
+/// @oracle 明示scope不在では何も登録しない。
+/// @cleanup Channelとscopeは試験終了で破棄する。
+/// @boundary 操作はSupervisor所有ChildまたはReaderだけが発行する。
+pub(crate) fn bind_host(
+    owner: Option<FaultOwner>,
+    pid: u32,
+    generation: u64,
+) -> Option<(ConnectionFault, mpsc::UnboundedReceiver<FaultRequest>)> {
+    let owner = owner?;
+    let (sender, receiver) = mpsc::unbounded_channel();
+    let previous = owner.0.lock().expect("fault state lock").hosts.insert(
+        (pid, generation),
+        HostRecord {
+            sender,
+            requested: None,
+            issued: None,
+            supervisor_branch: None,
+        },
+    );
+    assert!(previous.is_none(), "duplicate host generation");
+    Some((
+        ConnectionFault {
+            owner,
+            pid,
+            generation,
+        },
+        receiver,
+    ))
+}
+
+impl ConnectionFault {
+    /// 実Driverに登録され搬送Queueへ受理された待機要求を記録する。
+    /// @responsibility 未pollのFutureを実pending要求と混同しない。
+    /// @trace ERB-IT-029
+    /// @precondition 同じCellのWaitが実pending tableと搬送Queueへ登録済み。
+    /// @stimulus 公開Cell ID。
+    /// @observation 待機開始点。
+    /// @oracle 同じHost世代に登録済みのCellだけを受理する。
+    /// @cleanup scope破棄で記録を解放する。
+    /// @boundary Queue受理をHost受信や失敗確定とは扱わない。
+    pub(crate) fn wait_started(
+        &self,
+        cell_id: &str,
+        request_id: RequestId,
+        token: CancellationToken,
+    ) {
+        let mut state = self.owner.0.lock().expect("fault state lock");
+        assert_eq!(state.cells.get(cell_id), Some(&(self.pid, self.generation)));
+        let waits = state.pending_waits.entry(cell_id.into()).or_default();
+        assert!(
+            !waits.iter().any(|(id, _)| *id == request_id),
+            "duplicate request binding"
+        );
+        waits.push((request_id, token));
+    }
+
+    /// 終了・取消したexact Requestだけを現在表から解除する。
+    /// @responsibility 同じCellの別待機を消さない。
+    /// @trace ERB-IT-029
+    /// @precondition 同じConnectionのRequestが完了または取消処置へ入った。
+    /// @stimulus 終端するRequest ID。
+    /// @observation 所有Host世代に属するCellの現在待機表。
+    /// @oracle 別Connectionの同番号Requestと同じCellの別Requestを残す。
+    /// @cleanup 対象待機だけを除き、空の待機表を解放する。
+    /// @boundary Connection内の登録解除でありHost終了の証明ではない。
+    pub(crate) fn wait_finished(&self, request_id: RequestId) {
+        let mut state = self.owner.0.lock().expect("fault state lock");
+        let cells: Vec<_> = state
+            .cells
+            .iter()
+            .filter(|(_, identity)| **identity == (self.pid, self.generation))
+            .map(|(cell, _)| cell.clone())
+            .collect();
+        for cell in cells {
+            if let Some(waits) = state.pending_waits.get_mut(&cell) {
+                waits.retain(|(id, _)| *id != request_id);
+                if waits.is_empty() {
+                    state.pending_waits.remove(&cell);
+                }
+            }
+        }
+    }
+
+    /// 実Cell終了時に現在対応を解除する。
+    /// @responsibility 閉鎖済Cellへの新しい注入を拒否する。
+    /// @trace ERB-IT-029
+    /// @precondition 所有ConnectionがCell終了を処置している。
+    /// @stimulus 終了したCell ID。
+    /// @observation Cellと待機要求の現在対応。
+    /// @oracle 終了Cellは新しい注入対象として取得できない。
+    /// @cleanup Cell対応と同じCellの待機表を解除する。
+    /// @boundary 発行済み故障履歴は消さない。
+    pub(crate) fn cell_closed(&self, cell_id: &str) {
+        let mut state = self.owner.0.lock().expect("fault state lock");
+        state.cells.remove(cell_id);
+        state.pending_waits.remove(cell_id);
+    }
+
+    /// Connection失敗時に同じHostの全現在対応を解除する。
+    /// @responsibility 発行履歴と現在pendingを分離する。
+    /// @trace ERB-IT-029
+    /// @precondition 所有Connectionが失敗終端へ入った。
+    /// @stimulus Connectionの終端処置。
+    /// @observation 同じHost世代に属する全Cellの現在対応。
+    /// @oracle 別Host世代の対応を残し、閉鎖Connectionへの新しい注入を拒否する。
+    /// @cleanup 所有Cell対応と待機表を解除する。
+    /// @boundary 実Host reapと全Task終了は別の観測器で確認する。
+    pub(crate) fn connection_closed(&self) {
+        let mut state = self.owner.0.lock().expect("fault state lock");
+        let cells: Vec<_> = state
+            .cells
+            .iter()
+            .filter(|(_, identity)| **identity == (self.pid, self.generation))
+            .map(|(cell, _)| cell.clone())
+            .collect();
+        for cell in cells {
+            state.cells.remove(&cell);
+            state.pending_waits.remove(&cell);
+        }
+    }
+    /// 実HostのExecutionStarted受理点で公開Cellを結合する。
+    /// @responsibility Cellの文字列から世代を推測しない。
+    /// @trace ERB-IT-029
+    /// @precondition 同じConnectionがExecutionStartedを受理した。
+    /// @stimulus 実admit_cellの公開ID。
+    /// @observation CellとHost世代の対応。
+    /// @oracle 重複Cellを拒否する。
+    /// @cleanup scope破棄で対応を解放する。
+    /// @boundary 読取り観測器に操作権を追加しない。
+    pub(crate) fn bind_cell(&self, cell_id: &str) {
+        let previous = self
+            .owner
+            .0
+            .lock()
+            .expect("fault state lock")
+            .cells
+            .insert(cell_id.into(), (self.pid, self.generation));
+        assert!(previous.is_none(), "duplicate fault cell binding");
+    }
+
+    /// 要求と実Connectionの結合を操作前に照合する。
+    /// @responsibility 別Cellと別世代への故障Effectを拒否する。
+    /// @trace ERB-IT-029
+    /// @precondition Channelから固定要求を受理した。
+    /// @stimulus 要求のCell、PIDと世代。
+    /// @observation 登録済みexact対応。
+    /// @oracle 全Identity一致の場合だけtrue。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary PID名や世代文字列の再構成を行わない。
+    pub(crate) fn matches(&self, target: &FaultTarget) -> bool {
+        target.pid == self.pid
+            && target.generation == self.generation
+            && self
+                .owner
+                .0
+                .lock()
+                .expect("fault state lock")
+                .current(target)
+    }
+
+    /// 操作の要求発行を記録する。終了観測ではない。
+    /// @responsibility start_killとabortを実reapと区別する。
+    /// @trace ERB-IT-029
+    /// @precondition exact対象への操作APIが受理した。
+    /// @stimulus 故障種別。
+    /// @observation 発行した種別。
+    /// @oracle 二回目の発行を拒否する。
+    /// @cleanup scope破棄で記録を解放する。
+    /// @boundary 成功結果や資源不存在を生成しない。
+    pub(crate) fn issued(&self, kind: FaultKind, target: FaultTarget) {
+        let mut state = self.owner.0.lock().expect("fault state lock");
+        let host = state
+            .hosts
+            .get_mut(&(self.pid, self.generation))
+            .expect("known host");
+        assert!(
+            host.issued.replace((kind, target)).is_none(),
+            "duplicate injection"
+        );
+    }
+
+    /// 実Supervisorが最初に選んだ終端分岐を保存する。
+    /// @responsibility Host停止とstdout EOFの競合を固定順序へ偽装しない。
+    /// @trace ERB-IT-029
+    /// @precondition 実Supervisorが終端分岐へ入った。
+    /// @stimulus 実分岐名。
+    /// @observation 最初の選択結果。
+    /// @oracle 二つの終端分岐を同時成立へ畳まない。
+    /// @cleanup scope破棄で記録を解放する。
+    /// @boundary failureやDriverEventを直接書き換えない。
+    pub(crate) fn branch(&self, branch: &'static str) {
+        let mut state = self.owner.0.lock().expect("fault state lock");
+        let host = state
+            .hosts
+            .get_mut(&(self.pid, self.generation))
+            .expect("known host");
+        assert!(
+            host.supervisor_branch.replace(branch).is_none(),
+            "duplicate supervisor branch"
+        );
+    }
+}
+
+impl FaultOwner {
+    /// 故障注入前に同じCellの実待機登録を確認する。
+    /// @responsibility 遅延時間だけから待機開始を推定しない。
+    /// @trace ERB-IT-029
+    /// @precondition 実ExecutionStartedとYieldedを確認した。
+    /// @stimulus exact対象。
+    /// @observation Driverの待機登録点。
+    /// @oracle 未登録と不一致はfalse。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary Host受信完了の主張ではない。
+    pub fn wait_started(&self, target: &FaultTarget) -> bool {
+        let state = self.0.lock().expect("fault state lock");
+        state.current(target)
+    }
+    /// 実CellのHost対象を読取り取得する。
+    /// @responsibility 未登録Cellを注入対象にしない。
+    /// @trace ERB-IT-029
+    /// @precondition 実Cell開始を観測した。
+    /// @stimulus 公開Cell ID。
+    /// @observation exact PIDと世代。
+    /// @oracle 不明CellはNone。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary 一scope一Hostという件数から対象を推測しない。
+    pub fn target(&self, cell_id: &str) -> Option<FaultTarget> {
+        let state = self.0.lock().expect("fault state lock");
+        let &(pid, generation) = state.cells.get(cell_id)?;
+        let mut waits = state
+            .pending_waits
+            .get(cell_id)?
+            .iter()
+            .filter(|(_, token)| !token.is_cancelled());
+        let &(request_id, _) = waits.next()?;
+        if waits.next().is_some() {
+            return None;
+        }
+        Some(FaultTarget {
+            cell_id: cell_id.into(),
+            pid,
+            generation,
+            request_id,
+        })
+    }
+
+    /// exact Connectionへ一回だけ故障要求を渡す。
+    /// @responsibility 異なる対象、二重注入と閉鎖Channelを拒否する。
+    /// @trace ERB-IT-029
+    /// @precondition pending Cellと対象を試験側で確認した。
+    /// @stimulus 故障種別とexact対象。
+    /// @observation Supervisorの操作受理結果。
+    /// @oracle 受理を故障完了や回収成功と同一視しない。
+    /// @cleanup 保留要求は所有Connection終端で失敗させる。
+    /// @boundary 通常の取消Token、Providerまたは別Processへ触れない。
+    pub async fn inject(&self, target: FaultTarget, kind: FaultKind) -> Result<(), String> {
+        let (sender, response) = oneshot::channel();
+        {
+            let mut state = self.0.lock().expect("fault state lock");
+            if !state.current(&target) {
+                return Err("fault_target_mismatch".into());
+            }
+            let host = state
+                .hosts
+                .get_mut(&(target.pid, target.generation))
+                .ok_or("fault_host_unknown")?;
+            if host.requested.is_some() {
+                return Err("fault_already_requested".into());
+            }
+            host.requested = Some((kind, target.clone()));
+            host.sender
+                .send(FaultRequest {
+                    target,
+                    kind,
+                    response: sender,
+                })
+                .map_err(|_| "fault_connection_closed")?;
+        }
+        response
+            .await
+            .map_err(|_| "fault_response_unobserved".to_string())?
+    }
+
+    /// 発行後の実Supervisor分岐を読取り取得する。
+    /// @responsibility 注入発行と実故障処置を共同照合する。
+    /// @trace ERB-IT-029
+    /// @precondition 注入要求が終端した。
+    /// @stimulus exact対象と種別。
+    /// @observation 発行種別と実分岐。
+    /// @oracle 未発行または未観測はNone。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary 実reapとTask終了は別のObserverで確認する。
+    pub fn branch_after_injection(
+        &self,
+        target: &FaultTarget,
+        kind: FaultKind,
+    ) -> Option<&'static str> {
+        let state = self.0.lock().expect("fault state lock");
+        let host = state.hosts.get(&(target.pid, target.generation))?;
+        if host.issued.as_ref() != Some(&(kind, target.clone())) {
+            return None;
+        }
+        host.supervisor_branch
+    }
+}
