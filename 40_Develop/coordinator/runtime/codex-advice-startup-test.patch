+
+    /// 相関欠測、別呼出、重複、順序違いとnamespace違いを拒否する。
+    /// @responsibility 観測器のfalse positiveを決定論的に反証する。
+    /// @trace ERB-IT-027
+    /// @precondition 外部TaskやHostを起動しないstd限定の観測器試験。
+    /// @stimulus 正常記録と各破損記録を別scope値へ構築する。
+    /// @observation 同じCellの拒否観測判定。
+    /// @oracle 完全な一要求だけが成立し、plain/functions以外は統合しない。
+    /// @cleanup N/A: メモリ値だけであり外部資源を取得しない。
+    /// @boundary 実Host・実配送・全資源終了の証明ではない。
+    #[test]
+    fn delegate_correlation_rejects_missing_split_duplicate_and_reordered_events() {
+        let stages = [
+            DelegateStage::IpcReceived,
+            DelegateStage::BodyStarted,
+            DelegateStage::CoreSubmitted,
+            DelegateStage::RegistryRejected,
+            DelegateStage::BodyCompleted,
+            DelegateStage::DriverQueueAccepted,
+        ];
+        for case in 0..7 {
+            let observation = Observation::default();
+            for (index, stage) in stages.iter().enumerate() {
+                if case == 1 && index == 3 {
+                    continue;
+                }
+                let runtime = if case == 2 && index == 3 {
+                    "other"
+                } else {
+                    "call"
+                };
+                let stage = if case == 4 && index == 2 {
+                    stages[3]
+                } else if case == 4 && index == 3 {
+                    stages[2]
+                } else {
+                    *stage
+                };
+                let namespace = if case == 5 {
+                    Some("mcp__fixture")
+                } else {
+                    None
+                };
+                observation.delegate_stage(stage, "cell", runtime, namespace, "audit_probe");
+                if case == 6 {
+                    observation.delegate_stage(
+                        stage,
+                        "cell",
+                        "second-complete-call",
+                        namespace,
+                        "audit_probe",
+                    );
+                }
+                if case == 3 && index == 3 {
+                    observation.delegate_stage(stage, "cell", runtime, namespace, "audit_probe");
+                }
+            }
+            assert_eq!(
+                observation.delegate_rejection_observed("cell", Some("functions"), "audit_probe"),
+                case == 0,
+                "case {case}"
+            );
+            assert!(!observation.delegate_rejection_observed("other-cell", None, "audit_probe"));
+            assert!(!observation.delegate_rejection_observed("cell", None, "other-name"));
+            if case == 5 {
+                assert!(observation.delegate_rejection_observed(
+                    "cell",
+                    Some("mcp__fixture"),
+                    "audit_probe"
+                ));
+            }
+        }
+        for second_request in [false, true] {
+            let observation = Observation::default();
+            for stage in stages {
+                observation.delegate_stage(stage, "cell", "call", None, "audit_probe");
+            }
+            assert!(observation.delegate_rejection_observed("cell", None, "audit_probe"));
+            if second_request {
+                for stage in stages {
+                    observation.delegate_stage(stage, "cell", "late-call", None, "audit_probe");
+                }
+            } else {
+                observation.delegate_stage(
+                    DelegateStage::RegistryRejected,
+                    "cell",
+                    "call",
+                    None,
+                    "audit_probe",
+                );
+            }
+            assert!(!observation.delegate_rejection_observed("cell", None, "audit_probe"));
+        }
+    }
