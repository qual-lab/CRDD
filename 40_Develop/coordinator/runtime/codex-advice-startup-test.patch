+            /// @responsibility 固定FutureをPendingに保つ。
+            /// @trace ERB-IT-025
+            /// @precondition BlockingDropを所有する。
+            /// @stimulus poll要求。
+            /// @observation Poll::Pending。
+            /// @oracle 常にPending。
+            /// @cleanup N/A: pollではChannelを操作しない。
+            /// @boundary 局所Futureのみ。
+            fn poll(
+                self: std::pin::Pin<&mut Self>,
+                _: &mut std::task::Context<'_>,
+            ) -> std::task::Poll<()> {
+                std::task::Poll::Pending
