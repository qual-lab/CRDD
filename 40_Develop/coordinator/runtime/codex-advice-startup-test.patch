+    /// @observation 破棄前後のReader終了状態。
+    /// @oracle 破棄前false、破棄後true。
+    /// @cleanup FutureとInstallationを破棄する。
+    /// @boundary 実Host生成は行わない。
+    #[test]
+    fn unpolled_wrapped_future_is_registered_and_drop_observed() {
+        let observation = Observation::default();
+        let installation = install(observation.clone());
+        host_started(44).expect("installed scope").reaped(true);
+        let future = observe_future(Role::Reader, std::future::pending::<()>());
+        assert!(!observation.is_closed(&[Role::Reader]));
+        drop(future);
+        assert!(observation.is_closed(&[Role::Reader]));
+        drop(installation);
+    }
+
+    /// PID再利用後の遅延reapを旧scopeへ結ぶ。
+    /// @responsibility 同PIDの別Host結果を混同しない。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition AとBを順に登録する。
+    /// @stimulus 同PIDの二つのHost結合を作り、旧reapを遅延させる。
+    /// @observation 両scopeのclosed。
+    /// @oracle 旧reapだけでBはclosedにならない。
+    /// @cleanup 両Host記録を終端し、Installationを破棄する。
+    /// @boundary 固定記録の相関試験でありProcess操作はない。
