+        let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+        let future = observe_future(
+            Role::Reader,
+            BlockingDrop {
+                entered: entered_tx,
+                release: release_rx,
+            },
+        );
+        let worker = std::thread::spawn(move || drop(future));
+        entered_rx
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("inner drop began");
