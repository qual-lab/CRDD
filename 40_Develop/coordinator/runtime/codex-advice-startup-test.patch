+    /// @observation closedとscope不在時のNone。
+    /// @oracle 予約中false、破棄後true、登録解除後はNone。
+    /// @cleanup GuardとInstallationを破棄する。
+    /// @boundary 実Shutdown処理は開始しない。
+    #[test]
+    fn installed_scope_registers_future_reservation_before_poll() {
+        let observation = Observation::default();
+        let installation = install(observation.clone());
+        host_started(33).expect("installed scope").reaped(true);
+        let reservation = observe_task(Role::SessionShutdown);
+        assert!(!observation.is_closed(&[Role::SessionShutdown]));
+        drop(reservation);
+        assert!(observation.is_closed(&[Role::SessionShutdown]));
+        drop(installation);
+        assert!(observe_task(Role::Reader).is_none());
+    }
+
+    /// 空表とreap欠測をclosedにしない。
+    /// @responsibility 未観測を正常終了へ補完しない。
+    /// @trace ERB-IT-025
+    /// @precondition 新しい観測値を用意する。
+    /// @stimulus 空表、Host登録、Reader終了、reap成功を順に構築する。
+    /// @observation 必須Role別のclosed。
+    /// @oracle reap欠測とWriter欠測はfalse。
+    /// @cleanup 観測値を解放する。
+    /// @boundary メモリ上のOracle反証である。
+    #[test]
+    fn empty_or_unobserved_is_not_closed() {
+        let observation = Observation::default();
+        assert!(!observation.is_closed(&[]));
+        observation.host_started(12, 1);
+        drop(observation.task(Role::Reader));
+        assert!(!observation.is_closed(&[Role::Reader]));
+        observation.host_reap_observed(12, 1, true);
+        assert!(observation.is_closed(&[Role::Reader]));
+        assert!(!observation.is_closed(&[Role::Writer]));
+    }
+
+    /// 配送終了だけで実Body終了としない。
+    /// @responsibility delegateの二つの寿命を分離する。
+    /// @trace ERB-IT-027
+    /// @precondition 固定Hostの成功reap記録を用意する。
+    /// @stimulus Bodyを保持したままDeliveryを終了し、その後Bodyを終了する。
+    /// @observation 二Roleを要求したclosed。
+    /// @oracle Body保留中false、両終了後true。
+    /// @cleanup 両Guardと観測値を解放する。
+    /// @boundary 実delegate搬送の証明ではない。
+    #[test]
+    fn delivery_end_does_not_prove_body_end() {
+        let observation = Observation::default();
+        observation.host_started(12, 1);
+        observation.host_reap_observed(12, 1, true);
+        let body = observation.task(Role::DelegateBody);
+        drop(observation.task(Role::DelegateDelivery));
+        assert!(!observation.is_closed(&[Role::DelegateBody, Role::DelegateDelivery]));
+        drop(body);
+        assert!(observation.is_closed(&[Role::DelegateBody, Role::DelegateDelivery]));
+    }
+
+    /// 別世代の成功と同世代の失敗を終了成功にしない。
+    /// @responsibility PID一致だけでreap結果を流用しない。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 同PIDの二世代を記録する。
+    /// @stimulus 片側を成功、他方を未観測後に失敗へ更新する。
+    /// @observation 全世代を含むclosed。
+    /// @oracle 未観測と失敗のどちらでもfalse。
+    /// @cleanup 観測値とGuardを解放する。
+    /// @boundary 実Child waitの代替ではない。
+    #[test]
+    fn failed_reap_and_other_generation_do_not_prove_exit() {
+        let observation = Observation::default();
+        observation.host_started(12, 1);
+        observation.host_started(12, 2);
+        observation.host_reap_observed(12, 1, true);
+        drop(observation.task(Role::Supervisor));
+        assert!(!observation.is_closed(&[Role::Supervisor]));
+        observation.host_reap_observed(12, 2, false);
+        assert!(!observation.is_closed(&[Role::Supervisor]));
+    }
+}
