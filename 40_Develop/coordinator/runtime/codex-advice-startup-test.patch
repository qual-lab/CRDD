+                crate::session::tests::shutdown_crdd_advice_session(session),
+            )
+            .await
+        } else {
+            Ok(true)
+        };
+        drop(owned_session);
+        drop(provider);
+        let mut roles = vec![
+            Role::Reader,
+            Role::Writer,
+            Role::Driver,
+            Role::Supervisor,
+            Role::Stderr,
+            Role::CoreWorker,
+            Role::Watcher,
+            Role::SessionOpen,
+            Role::SessionShutdown,
+        ];
+        if check_forbidden_delegate {
+            roles.extend([
+                Role::DelegateBody,
+                Role::DelegateDelivery,
+                Role::CoreDispatch,
+            ]);
+        }
+        let closure = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            while !observation.resources_settled() {
+                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+            }
+        })
+        .await;
+        assert!(
+            matches!(shutdown, Ok(true)),
+            "real Session shutdown must complete"
+        );
+        assert!(
+            closure.is_ok(),
+            "all registered tasks and owned Host must finish"
+        );
+        assert!(
+            home.path().is_dir() && workspace.path().is_dir(),
+            "isolated roots must survive cleanup"
+        );
+        match result {
+            Ok(Ok(Ok(()))) => {
+                if check_forbidden_delegate {
+                    assert_eq!(completed_delegate_requests.len(), 3);
+                    for (cell_id, name, calls) in &completed_delegate_requests {
+                        assert!(
+                            observation.delegate_rejection_observed(
+                                cell_id.as_str(),
+                                name.namespace.as_deref(),
+                                &name.name
+                            ),
+                            "late duplicate or mismatched request must invalidate final success"
+                        );
+                        assert_eq!(
+                            calls.load(Ordering::SeqCst),
+                            0,
+                            "forbidden Handler must remain uncalled after cleanup"
+                        );
+                    }
+                }
+                assert!(
+                    observation.is_closed(&roles),
+                    "normal scenario must observe every required role"
+                );
+                Ok(())
+            }
+            Ok(Ok(Err(error))) => Err(error),
+            Ok(Err(timeout)) => Err(timeout.into()),
+            Err(panic) => std::panic::resume_unwind(panic),
+        }
+    }
+}
