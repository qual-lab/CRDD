+/// 実Host生成時の観測結合を保持する。
+/// @responsibility PID再利用後も旧reapを旧世代へ結ぶ。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @shape 開始時Observation、実PIDと生成世代。
+/// @invariant 終了記録までOwnerと世代を変更しない。
+/// @boundary Child生成とreap観測。
+/// @security PIDの値だけでProcess操作を許可しない。
+/// @compatibility N/A: 当該Host寿命の非永続値である。
+pub struct HostObservation {
+    observation: Observation,
+    pid: u32,
+    generation: u64,
+}
+
+/// 実生成済みHostを現在scopeへ登録する。
+/// @responsibility 未終了の同PIDを別Hostとして重複登録しない。
+/// @trace ERB-IT-025 ERB-IT-029
+/// @precondition Child生成が成功し、実PIDが取得済み。
+/// @stimulus 実PIDを登録する。
+/// @observation scope内の新しい生成世代。
+/// @oracle PIDは正値、未終了の同PIDが存在しない。
+/// @cleanup 呼出側が実reap結果をHostObservationへ渡す。
+/// @boundary 登録はProcess生成や終了を発行しない。
+pub fn host_started(pid: u32) -> Option<HostObservation> {
+    current_observation().as_ref().map(|observation| {
+        let mut state = observation.0.lock().expect("observation lock poisoned");
+        state.next += 1;
+        let generation = state.next;
+        assert!(pid > 0);
+        assert!(
+            !state
+                .hosts
+                .iter()
+                .any(|((existing, _), result)| *existing == pid && result.is_none())
+        );
+        state.hosts.insert((pid, generation), None);
+        HostObservation {
+            observation: observation.clone(),
+            pid,
+            generation,
+        }
+    })
+}
+
+impl HostObservation {
+    /// 実生成時のPIDと世代を読取り取得する。
+    /// @responsibility 操作Ownerへ推測ではないIdentityを渡す。
+    /// @trace ERB-IT-029
+    /// @precondition 実生成済みHostの観測結合を保持している。
+    /// @stimulus Identityの読取り。
+    /// @observation 実PIDと登録世代。
+    /// @oracle 登録時の組をそのまま返す。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary 故障操作の許可判断は別Ownerが行う。
+    pub fn identity(&self) -> (u32, u64) {
+        (self.pid, self.generation)
+    }
+
+    /// 所有Hostの実reap結果を記録する。
+    /// @responsibility 終了要求発行をreap成立と混同しない。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 呼出側が実Child waitの結果を取得している。
+    /// @stimulus reap確認の成否。
+    /// @observation 開始時PIDと世代の結果。
+    /// @oracle 失敗はSome(false)として保持する。
+    /// @cleanup 消費した結合を解放する。
+    /// @boundary Hostへのkillやwaitをこの関数から発行しない。
+    pub fn reaped(self, succeeded: bool) {
+        self.observation
+            .host_reap_observed(self.pid, self.generation, succeeded);
+    }
+}
+
+impl Observation {
+    /// 一要求の観測を順序付きで保存する。重複も削除しない。
+    /// @responsibility 欠測と重複を後段Oracleから識別可能にする。
+    /// @trace ERB-IT-027
+    /// @precondition Cell、Runtime IDとTool名は非空である。
+    /// @stimulus 実搬送点の段階とIdentityを渡す。
+    /// @observation 同じ正規化Identityの全段階。
+    /// @oracle plainとfunctionsを同一視し、他namespaceは保持する。
+    /// @cleanup N/A: scope所有のメモリ記録だけである。
+    /// @boundary 表示文字列をIdentityとして再解釈しない。
+    pub fn delegate_stage(
+        &self,
+        stage: DelegateStage,
+        cell_id: &str,
+        runtime_id: &str,
+        namespace: Option<&str>,
+        name: &str,
+    ) {
+        assert!(!cell_id.is_empty() && !runtime_id.is_empty() && !name.is_empty());
+        let namespace = match namespace {
+            None | Some("") | Some("functions") => "functions",
+            Some(value) => value,
+        };
+        self.0
+            .lock()
+            .expect("observation lock poisoned")
+            .delegates
+            .entry((
+                cell_id.into(),
+                runtime_id.into(),
+                namespace.into(),
+                name.into(),
+            ))
+            .or_default()
+            .push(stage);
+    }
+
+    /// 一Cellの拒否要求がexactな搬送順序を通ったか確認する。
+    /// @responsibility 別呼出の断片やRole存在を要求相関の代替にしない。
+    /// @trace ERB-IT-027
+    /// @precondition 対象Cellと正規化Tool Identityを把握している。
+    /// @stimulus 同じCellの結果を観測後に照合する。
+    /// @observation Cell内の要求数、Identityと全段階順序。
+    /// @oracle 一要求だけが全六段階を一回ずつ順序通り観測した場合だけtrue。
+    /// @cleanup N/A: 読取りだけであり待機や終了要求を発行しない。
+    /// @boundary Host結果、Handler 0と全資源終了は別に要求する。
+    pub fn delegate_rejection_observed(
+        &self,
+        cell_id: &str,
+        namespace: Option<&str>,
+        name: &str,
+    ) -> bool {
+        let namespace = match namespace {
+            None | Some("") | Some("functions") => "functions",
+            Some(value) => value,
+        };
+        let state = self.0.lock().expect("observation lock poisoned");
+        let mut requests = state
+            .delegates
+            .iter()
+            .filter(|((cell, _, _, _), _)| cell == cell_id);
+        let Some(((_, _, observed_namespace, observed_name), stages)) = requests.next() else {
+            return false;
+        };
+        requests.next().is_none()
+            && observed_namespace == namespace
+            && observed_name == name
+            && stages.as_slice()
+                == [
+                    DelegateStage::IpcReceived,
+                    DelegateStage::BodyStarted,
+                    DelegateStage::CoreSubmitted,
+                    DelegateStage::RegistryRejected,
+                    DelegateStage::BodyCompleted,
+                    DelegateStage::DriverQueueAccepted,
+                ]
+    }
+
+    /// 所有scopeへRole別Taskを登録する。
+    /// @responsibility 同じRoleの複数Taskを個別IDで保持する。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition Task寿命を呼出側が所有する。
+    /// @stimulus Roleを登録する。
+    /// @observation 新しい単調IDと未終了記録。
+    /// @oracle 登録IDを重複しない。
+    /// @cleanup GuardのDropで同IDを終了済みにする。
+    /// @boundary 登録だけで実Taskを生成しない。
+    pub fn task(&self, role: Role) -> TaskGuard {
+        let mut state = self.0.lock().expect("observation lock poisoned");
+        state.next += 1;
+        let id = state.next;
+        assert!(state.tasks.insert(id, (role, false)).is_none());
+        TaskGuard {
+            observation: self.clone(),
+            id,
+        }
+    }
+
+    /// 単体反証用のHost世代を明示登録する。
+    /// @responsibility 既知Identityの重複登録を拒否する。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 単体試験が固定PIDと世代を用意する。
+    /// @stimulus 非ゼロPIDと世代を登録する。
+    /// @observation 未観測reap記録。
+    /// @oracle 同じ組の再登録を拒否する。
+    /// @cleanup Owner解放で記録を解放する。
+    /// @boundary この登録を実Host生成の証明にしない。
+    pub fn host_started(&self, pid: u32, generation: u64) {
+        assert!(pid > 0 && generation > 0);
+        let mut state = self.0.lock().expect("observation lock poisoned");
+        assert!(state.hosts.insert((pid, generation), None).is_none());
+    }
+
+    /// 登録済み世代のreap結果を一回だけ反映する。
+    /// @responsibility 未登録と重複観測を拒否する。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 同じPID／世代が開始表に存在する。
+    /// @stimulus 観測したreapの成否。
+    /// @observation 同じ世代のSome(true)またはSome(false)。
+    /// @oracle 未観測Noneと失敗falseを区別する。
+    /// @cleanup Owner解放まで結果を保持する。
+    /// @boundary PID再利用の別世代へ結果を流用しない。
+    pub fn host_reap_observed(&self, pid: u32, generation: u64, succeeded: bool) {
+        let mut state = self.0.lock().expect("observation lock poisoned");
+        let result = state
+            .hosts
+            .get_mut(&(pid, generation))
+            .expect("unknown host generation");
+        assert!(result.is_none(), "duplicate reap observation");
+        *result = Some(succeeded);
+    }
+
+    /// 登録済み資源の終了だけを評価する。試験実行の成立は示さない。
+    /// @responsibility 終了評価とシナリオ成立を分ける。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 必要な資源を呼出側が別に登録確認する。
+    /// @stimulus 終了状態の照合。
+    /// @observation 登録Hostのreapと全Taskの終了。
+    /// @oracle 全登録資源の正常終了だけをtrueとする。空表もtrueである。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary 資源存在や試験実行の証明にはis_closed等を併用する。
+    pub fn resources_settled(&self) -> bool {
+        let state = self.0.lock().expect("observation lock poisoned");
+        state.hosts.values().all(|result| *result == Some(true))
+            && state.tasks.values().all(|(_, ended)| *ended)
+    }
+
+    /// 必須Roleと実Host登録を含めて終了を照合する。
+    /// @responsibility 空表やRole欠測を終了成功と扱わない。
+    /// @trace ERB-IT-025 ERB-IT-027 ERB-IT-029
+    /// @precondition シナリオの必須Role集合を確定済み。
+    /// @stimulus 必須Roleを照合する。
+    /// @observation Host／Taskの登録、全終了結果とRole存在。
+    /// @oracle 非空登録、全正常終了、全必須Role観測の連言だけをtrueとする。
+    /// @cleanup N/A: 読取りだけである。
+    /// @boundary 未登録資源不存在や外側Container終了は別に確認する。
+    pub fn is_closed(&self, required_roles: &[Role]) -> bool {
+        let state = self.0.lock().expect("observation lock poisoned");
+        !state.hosts.is_empty()
+            && state.hosts.values().all(|result| *result == Some(true))
+            && !state.tasks.is_empty()
+            && state.tasks.values().all(|(_, ended)| *ended)
+            && required_roles
+                .iter()
+                .all(|required| state.tasks.values().any(|(role, _)| role == required))
+    }
+}
+
+impl Drop for TaskGuard {
+    /// 登録時Ownerの同じTaskを終了済みにする。
+    /// @responsibility 別scopeや別IDへ終了結果を流用しない。
+    /// @trace ERB-IT-025 ERB-IT-029
+    /// @precondition 登録Guardを所有処理の終端で破棄する。
+    /// @stimulus GuardのDrop。
+    /// @observation 登録IDの未終了状態。
+    /// @oracle 未登録IDと二重終了を拒否する。
+    /// @cleanup 同じTaskのendedをtrueへ更新する。
+    /// @boundary Guard破棄を実資源の終了要求として使わない。
+    fn drop(&mut self) {
+        let mut state = self
+            .observation
+            .0
+            .lock()
+            .expect("observation lock poisoned");
+        let (_, ended) = state.tasks.get_mut(&self.id).expect("unknown task");
+        assert!(!*ended, "duplicate task end");
+        *ended = true;
+    }
+}
