+    /// @observation bind先のOwnerと無効な開始条件。
+    /// @oracle 後からinstallしても未登録開始は注入不能、Aの開始はBへ移らない。
+    /// @cleanup Installation、ChannelとOwnerを破棄する。
+    /// @boundary Host生成なしのscope捕捉反証である。
+    #[test]
+    fn startup_owner_is_captured() {
+        let absent = capture_owner();
+        assert!(absent.is_none());
+        let first = FaultOwner::default();
+        let installation = install(first.clone());
+        let captured = capture_owner();
+        drop(installation);
+        let second = FaultOwner::default();
+        let _installation = install(second.clone());
+        assert!(bind_host(absent, 201, 1).is_none());
+        let (_binding, _receiver) = bind_host(captured, 202, 2).expect("captured first owner");
+        assert!(first.0.lock().expect("state").hosts.contains_key(&(202, 2)));
+        assert!(second.0.lock().expect("state").hosts.is_empty());
