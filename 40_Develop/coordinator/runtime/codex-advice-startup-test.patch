+    /// @security 秘密値や外部Provider要求を扱わない。
+    /// @compatibility 既存CoreToolRuntime契約へ無害な試験実装として接続する。
+    pub(super) struct CountedHandler {
+        pub(super) name: codex_tools::ToolName,
+        pub(super) calls: Arc<AtomicUsize>,
+    }
+
+    impl ToolExecutor<ToolInvocation> for CountedHandler {
+        /// 試験Handlerの登録名を返す。
