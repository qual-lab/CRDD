+        other.bind_cell("cell-c");
+        other.wait_started("cell-c", RequestId::new(1), CancellationToken::new());
+        let closed = owner.target("cell-c").expect("pending before close");
+        other.cell_closed("cell-c");
+        assert!(!other.matches(&closed));
+        assert!(owner.inject(closed, FaultKind::ReaderLoss).await.is_err());
+    }
+
+    /// 起動開始後のOwner切替を取り込まないことを反証する。
