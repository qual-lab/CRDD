{
  "name": "@qual-lab/crdd-coordinator",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    "./cli": "./bin/coordinator.ts",
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run runtime-traceability:check && npm run orchestrator-design-traceability:check",
    "claude-docker-runtime-adapter:coverage": "node --experimental-test-coverage --test ./tests/unit/execution/claude-preparation.contract.test.ts ./tests/unit/execution/model-selection.contract.test.ts",
    "claude-execution-plan:coverage": "node --experimental-test-coverage --test ./tests/unit/plain-data-snapshot.contract.test.ts ./tests/integration/claude-execution-plan.contract.test.ts",
    "coordinator-task-runtime:coverage": "node --experimental-test-coverage --test ./tests/integration/coordinator-task-runtime.contract.test.ts ./tests/unit/execution/task-packet.contract.test.ts ./tests/unit/execution/task-structured-result.contract.test.ts",
    "dynamic-fake-provider:coverage": "node ./scripts/check-dynamic-fake-provider-coverage.ts",
    "dynamic-fake-provider:verify-cancellation": "node ./scripts/verify-dynamic-fake-provider-cancellation.ts",
    "dynamic-fake-provider:verify-failures": "node ./scripts/verify-dynamic-fake-provider-failures.ts",
    "format": "biome format --write ../..",
    "format:check": "biome format ../..",
    "lint": "biome lint ../.. --error-on-warnings",
    "platform-access:build": "npm run platform-access:worker-build",
    "platform-access:coverage": "node ./scripts/check-platform-access-coverage.ts",
    "platform-access:format:check": "cargo fmt --manifest-path ../platform-access/Cargo.toml --check",
    "platform-access:lint": "npm run platform-access:worker-lint",
    "platform-access:native-runtime-trace": "node ./scripts/check-native-runtime-trace.ts",
    "platform-access:verify-protection": "cd ../.. && node ./40_Develop/coordinator/scripts/verify-native-protection.ts",
    "platform-access:verify-namespace": "cd ../.. && node ./40_Develop/coordinator/scripts/verify-native-terminal-namespace.ts",
    "platform-access:verify-terminal-fixtures": "cd ../.. && node ./40_Develop/coordinator/scripts/verify-native-terminal-fixtures.ts",
    "platform-access:test": "cargo +1.94.1-x86_64-pc-windows-msvc test --manifest-path ../platform-access/Cargo.toml --frozen --all-features --target x86_64-pc-windows-msvc",
    "platform-access:ts-coverage": "node ./scripts/check-platform-access-ts-coverage.ts",
    "platform-access:worker-build": "cargo +1.94.1-x86_64-pc-windows-msvc build --manifest-path ../platform-access/Cargo.toml --frozen --release --target x86_64-pc-windows-msvc --bin crdd-platform-access",
    "platform-access:worker-lint": "cargo +1.94.1-x86_64-pc-windows-msvc clippy --manifest-path ../platform-access/Cargo.toml --frozen --target x86_64-pc-windows-msvc --bin crdd-platform-access -- -D warnings",
    "delegation-route-selection:coverage": "node --experimental-test-coverage --test ./tests/unit/execution/eligibility-observation.contract.test.ts ./tests/unit/provider-model-profile-runtime.contract.test.ts ./tests/unit/delegation-route-selection.contract.test.ts ./tests/unit/execution/delegation-selection-grant.contract.test.ts ./tests/unit/execution/claude-preparation.contract.test.ts ./tests/unit/execution/model-selection.contract.test.ts",
    "development-e2e:verify": "node --test --test-concurrency=1 ./tests/system/coordinator-launch.contract.test.ts ./tests/system/verification-result-record.contract.test.ts ./tests/system/interaction-boundary-regression.contract.test.ts ./tests/integration/claude-execution-plan.contract.test.ts ./tests/unit/execution/claude-preparation.contract.test.ts ./tests/unit/claude-subscription-authentication.contract.test.ts ./tests/integration/claude-subscription-authentication-recovery.integration.test.ts ./tests/integration/codex-execution-plan.contract.test.ts ./tests/unit/execution/codex-preparation.contract.test.ts ./tests/integration/coordinator-task-runtime.contract.test.ts ./tests/integration/coordinator-task-process.integration.test.ts ./tests/system/signed-general-task-verification.contract.test.ts ./tests/system/signed-reviewer-boundary-verification.contract.test.ts ./tests/system/signed-route-matrix-verification.contract.test.ts ./tests/system/signed-recovery-matrix-verification.contract.test.ts",
    "integration:real-reviewers": "node ./scripts/verify-reviewer-boundary.ts",
    "docker-process-controller:coverage": "node --experimental-test-coverage --test --test-concurrency=1 ../ai-adapter/tests/unit/claude/structured-result.contract.test.ts ../domain-model/tests/integration/committed-json.integration.test.ts ./tests/integration/docker-recovery-runtime.contract.test.ts ./tests/integration/docker-effect-runtime.contract.test.ts ./tests/integration/docker-process-controller.contract.test.ts ./tests/integration/coordinator-claude-delegation.integration.test.ts",
    "committed-json:coverage": "node --experimental-test-coverage --test-coverage-include=../domain-model/src/storage/committed-json.ts --test-coverage-include=src/execution/host-recovery-record.ts --test-coverage-include=../docker-isolation/src/cleanup/probe-record.ts --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=80 --test ../domain-model/tests/integration/committed-json.integration.test.ts ../domain-model/tests/unit/storage/committed-json.contract.test.ts ./tests/unit/execution/host-recovery-record.contract.test.ts ./tests/integration/host-recovery-record.contract.test.ts",
    "docker-recovery-production:coverage": "node --experimental-test-coverage --test-coverage-include=src/execution/recovery.ts --test-coverage-include=src/execution/recovery.ts --test-coverage-include=src/cli/command.ts --test-coverage-lines=65 --test-coverage-branches=45 --test-coverage-functions=75 --test --test-concurrency=1 ./tests/integration/docker-recovery-runtime.contract.test.ts ./tests/system/coordinator-docker-recovery-cli.integration.test.ts",
    "provider-authority:coverage": "node ./scripts/check-provider-authority-coverage.ts",
    "provider-home:coverage": "node ./scripts/check-provider-home-coverage.ts",
    "provider-home-mount-grant:coverage": "node --experimental-test-coverage --test ./tests/unit/plain-data-snapshot.contract.test.ts ./tests/unit/execution/provider-home-mount-grant.contract.test.ts",
    "provider-home-mount-grant-runtime:coverage": "node --experimental-test-coverage --test ./tests/unit/execution/provider-home-mount-authorization.contract.test.ts",
    "provider-lifecycle:coverage": "node --experimental-test-coverage --test ./tests/unit/execution/root-path.contract.test.ts ./tests/unit/plain-data-snapshot.contract.test.ts ./tests/unit/execution/provider-home.contract.test.ts ./tests/unit/execution/provider-lifecycle.contract.test.ts",
    "provider-model-selection-runtime:coverage": "node --experimental-test-coverage --test ./tests/unit/execution/model-selection.contract.test.ts",
    "orchestrator-design-traceability:check": "node ./scripts/check-orchestrator-design-traceability.ts",
    "repository-operation-runtime:coverage": "node --experimental-test-coverage --test ./tests/integration/repository-operation-runtime.contract.test.ts ./tests/integration/docker-process-controller.contract.test.ts",
    "runtime-traceability:check": "node ./scripts/check-runtime-traceability.ts",
    "test": "npm run check && npm run test:run",
    "test:run": "npm run test:portable",
    "test:portable": "node --experimental-test-module-mocks --test --test-concurrency=1 \"--test-skip-pattern=^(Host Windows:|Windows Process Gate:)\" ./tests/unit/**/*.test.ts ./tests/integration/*.test.ts ./tests/system/*.test.ts",
    "test:host-windows": "node --experimental-test-module-mocks --test --test-concurrency=1 \"--test-name-pattern=^Host Windows:\" ./tests/integration/docker-effect-runtime.contract.test.ts ./tests/integration/kernel-lock.contract.test.ts ./tests/integration/coordinator-state-runtime.contract.test.ts ./tests/integration/docker-recovery-owner-reentry.contract.test.ts ./tests/integration/host-recovery-record.contract.test.ts ./tests/integration/current-host-transition.integration.test.ts ./tests/integration/current-state-marker-cleanup.contract.test.ts ./tests/integration/coordinator-task-process.integration.test.ts ./tests/integration/codex-executor-sandbox.integration.test.ts ./tests/integration/docker-process-controller.contract.test.ts ./tests/integration/native-git-provenance.contract.test.ts ./tests/integration/host-terminal-caller-checkpoint.integration.test.ts ./tests/integration/orchestrator-durable-foundation.contract.test.ts ./tests/integration/orchestrator-history.contract.test.ts ./tests/integration/runtime-repair-owner.contract.test.ts ./tests/integration/docker-auth-create-closure.contract.test.ts ./tests/integration/development-native-observation.integration.test.ts",
    "test:docker-isolation-host": "tsc -p ./docker-isolation-tests-tsconfig.json && biome format ./tests/integration/docker-isolation-host.integration.test.ts && biome lint ./tests/integration/docker-isolation-host.integration.test.ts --error-on-warnings && node --test --test-concurrency=1 ./tests/integration/docker-isolation-host.integration.test.ts",
    "test:all": "npm run check && npm run test:run && npm run test:host-windows",
    "typecheck": "tsc -p ./tsconfig.strict.json && tsc -p ./tsconfig.tests.json"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
