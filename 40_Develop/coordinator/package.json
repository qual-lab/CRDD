{
  "name": "@qual-lab/crdd-coordinator",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    "./cli": "./bin/coordinator.ts",
    "./objective-child": "./src/objective-child.ts",
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run execution-traceability:check && npm run task-design-traceability:check",
    "claude-docker-adapter:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test ./tests/unit/execution/claude-preparation.contract.test.ts ./tests/unit/selection/resolve.contract.test.ts",
    "test:claude-execution-plan": "node --test ./tests/unit/plain-data-snapshot.contract.test.ts ./tests/integration/claude-execution-plan.contract.test.ts",
    "test:task-execution": "node --experimental-test-module-mocks --test ./tests/integration/coordinator-task-execution.contract.test.ts ./tests/unit/execution/task-packet.contract.test.ts",
    "dynamic-fake-provider:coverage": "node ./tests/support/check-dynamic-fake-provider-coverage.ts",
    "dynamic-fake-provider:verify-cancellation": "node ./tests/system/manual/verify-dynamic-fake-provider-cancellation.ts",
    "dynamic-fake-provider:verify-failures": "node ./tests/system/manual/verify-dynamic-fake-provider-failures.ts",
    "format": "biome format --write ../..",
    "format:check": "biome format ../..",
    "lint": "biome lint ../.. --error-on-warnings",
    "development-e2e:verify": "node --experimental-test-module-mocks --test --test-concurrency=1 ./tests/system/coordinator-launch.contract.test.ts ./tests/system/verification-result-record.contract.test.ts ./tests/system/interaction-boundary-regression.contract.test.ts ./tests/integration/claude-execution-plan.contract.test.ts ./tests/unit/execution/claude-preparation.contract.test.ts ./tests/unit/provider-authentication.contract.test.ts ./tests/integration/provider-authentication-recovery.integration.test.ts ./tests/integration/codex-execution-plan.contract.test.ts ./tests/unit/execution/codex-preparation.contract.test.ts ./tests/integration/coordinator-task-execution.contract.test.ts ./tests/integration/coordinator-task-process.integration.test.ts ./tests/system/signed-general-task-verification.contract.test.ts ./tests/system/signed-reviewer-boundary-verification.contract.test.ts ./tests/system/signed-route-matrix-verification.contract.test.ts ./tests/system/signed-recovery-matrix-verification.contract.test.ts",
    "integration:real-reviewers": "node ./tests/system/manual/verify-reviewer-boundary.ts",
    "test:docker-process-controller": "node --experimental-test-module-mocks --test --test-concurrency=1 ./tests/integration/docker-recovery.contract.test.ts ./tests/integration/docker-effect-dispatch.contract.test.ts ./tests/integration/docker-process-controller.contract.test.ts ./tests/integration/coordinator-claude-delegation.integration.test.ts",
    "host-recovery:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=src/lifecycle/environment.ts --test-coverage-include=src/lifecycle/host.ts --test-coverage-lines=90 --test-coverage-branches=70 --test-coverage-functions=80 --test --test-concurrency=1 \"./tests/unit/**/*.test.ts\"",
    "test:host-recovery": "node --experimental-test-module-mocks --test --test-concurrency=1 ./tests/integration/host-recovery-record.contract.test.ts ./tests/integration/docker-repair-owner.contract.test.ts ./tests/integration/docker-restart-recovery-storage.contract.test.ts",
    "docker-recovery:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=src/lifecycle/environment.ts --test-coverage-include=src/cli/command.ts --test-coverage-lines=65 --test-coverage-branches=45 --test-coverage-functions=75 --test --test-concurrency=1 \"./tests/unit/**/*.test.ts\"",
    "test:docker-recovery-production": "node --experimental-test-module-mocks --test --test-concurrency=1 ./tests/integration/docker-recovery.contract.test.ts ./tests/system/coordinator-docker-recovery-cli.integration.test.ts",
    "provider-home:coverage": "node ./tests/support/check-provider-home-coverage.ts",
    "provider-lifecycle:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test ./tests/unit/execution/root-path.contract.test.ts ./tests/unit/plain-data-snapshot.contract.test.ts ./tests/unit/execution/provider-home.contract.test.ts ./tests/unit/execution/provider-lifecycle.contract.test.ts",
    "task-design-traceability:check": "node ./tests/support/check-task-design-traceability.ts",
    "test:repository-operation": "node --experimental-test-module-mocks --test ./tests/integration/repository-operation.contract.test.ts ./tests/integration/docker-process-controller.contract.test.ts",
    "execution-traceability:check": "node ./tests/support/check-execution-traceability.ts",
    "test": "npm run check && npm run test:run",
    "test:run": "npm run test:portable",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --experimental-test-module-mocks --test --test-concurrency=1 \"--test-skip-pattern=^(Host Windows:|Windows Process Gate:|中立化したRuntime子Processから実Docker CLI|real Desktop CLI and WSL observation|署名済み候補で実Codex／Claude Reviewer境界)\" \"./tests/unit/**/*.test.ts\"",
    "test:portable": "node --experimental-test-module-mocks --test --test-concurrency=1 \"--test-skip-pattern=^(Host Windows:|Windows Process Gate:)\" ./tests/unit/**/*.test.ts ./tests/integration/*.test.ts ./tests/system/*.test.ts",
    "test:host-windows": "node --experimental-test-module-mocks --test --test-concurrency=1 \"--test-name-pattern=^Host Windows:\" ./tests/integration/docker-effect-dispatch.contract.test.ts ./tests/integration/coordinator-state-storage.contract.test.ts ./tests/integration/docker-restart-recovery-storage.contract.test.ts ./tests/integration/docker-recovery-owner-reentry.contract.test.ts ./tests/integration/host-recovery-record.contract.test.ts ./tests/integration/current-host-transition.integration.test.ts ./tests/integration/coordinator-task-process.integration.test.ts ./tests/integration/codex-executor-sandbox.integration.test.ts ./tests/integration/docker-process-controller.contract.test.ts ./tests/integration/task-durable-foundation.contract.test.ts ./tests/integration/docker-repair-owner.contract.test.ts ./tests/integration/docker-auth-create-closure.contract.test.ts ./tests/integration/development-native-observation.integration.test.ts",
    "test:docker-isolation-host": "tsc -p ./docker-isolation-tests-tsconfig.json && biome format ./tests/integration/docker-isolation-host.integration.test.ts && biome lint ./tests/integration/docker-isolation-host.integration.test.ts --error-on-warnings && node --test --test-concurrency=1 ./tests/integration/docker-isolation-host.integration.test.ts",
    "test:all": "npm run check && npm run test:run && npm run test:host-windows",
    "typecheck": "tsc -p ./tsconfig.strict.json && tsc -p ./tsconfig.tests.json",
    "selection:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test ./tests/unit/selection/resolve.contract.test.ts",
    "verify:provider": "node ./tests/system/manual/verify-provider-real.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@qual-lab/crdd-ai-adapter": "file:../ai-adapter",
    "@qual-lab/crdd-configuration-model": "file:../configuration-model",
    "@qual-lab/crdd-docker-isolation": "file:../docker-isolation",
    "@qual-lab/crdd-document-model": "file:../document-model",
    "@qual-lab/crdd-execution-intelligence": "file:../execution-intelligence",
    "@qual-lab/crdd-execution-model": "file:../execution-model",
    "@qual-lab/crdd-executor": "file:../executor",
    "@qual-lab/crdd-lock": "file:../lock",
    "@qual-lab/crdd-version-control": "file:../version-control"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
