{
  "name": "@qual-lab/crdd-access-management",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "crdd-access-management": "./bin/access-management.ts"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "tsc -p ./tsconfig.json",
    "start": "node ./bin/access-management.ts",
    "test": "npm run check && npm run test:run",
    "test:run": "node --test --test-concurrency=1 ./tests/unit/**/*.test.ts ./tests/integration/**/*.test.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
