{
  "name": "@qual-lab/crdd-coordinator",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "doctor": "node ./bin/coordinator.ts doctor",
    "format": "biome format --write ../..",
    "format:check": "biome format ../..",
    "lint": "biome lint ../.. --error-on-warnings",
    "release-key:generate": "node ./scripts/generate-release-key.ts",
    "release-manifest:sign": "node ./scripts/sign-release-manifest.ts",
    "test": "node --test ./tests/*.test.ts",
    "typecheck": "tsc -p ./tsconfig.strict.json && tsc -p ./tsconfig.tests.json"
  },
  "engines": {
    "node": ">=24.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.18.0",
    "typescript": "7.0.2"
  }
}
